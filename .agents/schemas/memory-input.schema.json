{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Memory input",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "episodic",
        "semantic",
        "procedural"
      ]
    },
    "content": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "user_statement",
            "tool_result"
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "locator"
      ],
      "additionalProperties": false
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "valid_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "required": [
    "kind",
    "content",
    "source",
    "confidence",
    "tags",
    "valid_until"
  ],
  "additionalProperties": false
}
