{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "user_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "episodic",
              "semantic",
              "procedural"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "user_statement",
                  "tool_result"
                ]
              },
              "locator": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "locator"
            ],
            "additionalProperties": false
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "valid_until": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "kind",
          "content",
          "source",
          "confidence",
          "tags",
          "valid_until",
          "id",
          "created_at",
          "updated_at",
          "revision"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "user_id",
    "records"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Repository file memories"
}
